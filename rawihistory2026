      hattin: { title: "حطين: خطة الحصار والسيطرة على المياه", desc: "تتبع حركة الكماشة الأيوبية التي قطعت الطريق نحو بحيرة طبريا.", color: "#D97757", path: "M 70 180 L 195 110 L 320 140" }
    };

    const themeToggle = document.getElementById("themeToggle");
    const themeIcon = document.getElementById("themeIcon");
    const themeLabel = document.getElementById("themeLabel");

    function applyTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("site-theme", theme);
      if (theme === "dark") {
        themeIcon.textContent = "📜";
        themeLabel.textContent = "الوضع العتيق";
      } else {
        themeIcon.textContent = "🌙";
        themeLabel.textContent = "الوضع المظلم";
      }
    }
    applyTheme(localStorage.getItem("site-theme") || "vintage");

    themeToggle.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme");
      applyTheme(current === "dark" ? "vintage" : "dark");
    });

    document.getElementById("mobileMenuBtn").addEventListener("click", () => {
      document.getElementById("navLinks").classList.toggle("open");
    });

    let activeEra = "all";
    let searchQuery = "";

    function renderStories() {
      const container = document.getElementById("stories");
      const filtered = storiesData.filter(s => {
        const matchEra = activeEra === "all" || s.era === activeEra;
        const matchSearch = s.title.includes(searchQuery) || s.excerpt.includes(searchQuery) || s.era.includes(searchQuery);
        return matchEra && matchSearch;
      });
      if (filtered.length === 0) {
        container.innerHTML = `<p style="color:var(--text-secondary); grid-column:1/-1; text-align:center; padding:2rem;">لا توجد نتائج مطابقة لبحثك حالياً.</p>`;
        return;
      }
      container.innerHTML = filtered.map(story => `
        <article class="story-card reveal visible">
          <div class="story-cover" style="background: linear-gradient(135deg, #2B2118 0%, #4E3B28 100%);">
            <span class="story-era-tag">العصر ال${story.era}</span>
            <svg width="110" height="110" viewBox="0 0 120 120" fill="none" opacity="0.28">
              <circle cx="60" cy="60" r="48" stroke="#C5A059" stroke-width="1.5" stroke-dasharray="4 4"/>
              <polygon points="60,18 75,48 105,60 75,72 60,102 45,72 15,60 45,48" stroke="#C5A059" stroke-width="1.2"/>
            </svg>
            <span style="position:absolute; bottom:10px; left:14px; color:#C5A059; font-family:Cairo; font-size:0.78rem; font-weight:700;">${story.date}</span>
          </div>
          <div class="story-body">
            <div class="story-meta"><span>⏱ ${story.readTime}</span><span>🗺 خريطة + موشن جرافيك</span></div>
            <h3>${story.title}</h3>
            <p>${story.excerpt}</p>
            <button class="read-more-btn" onclick="openStoryModal(${story.id})">اقرأ القصة كاملة ←</button>
          </div>
        </article>
      `).join("");
    }

    document.querySelectorAll(".era-pill").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".era-pill").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeEra = btn.dataset.era;
        renderStories();
      });
    });

    document.getElementById("searchInput").addEventListener("input", e => {
      searchQuery = e.target.value.trim();
      renderStories();
    });
    renderStories();

    function openStoryModal(id) {
      const story = storiesData.find(s => s.id === id);
      if (!story) return;
      document.getElementById("modalEraBadge").textContent = `العصر ال${story.era} • ${story.date}`;
      const pinsSvg = story.mapPins.map((pin, idx) => `
        <g class="map-pin" onclick="selectMapPin(${story.id}, ${idx})">
          <circle cx="${pin.x}" cy="${pin.y}" r="11" fill="#C5A059" fill-opacity="0.25" />
          <circle cx="${pin.x}" cy="${pin.y}" r="5.5" fill="#C5A059" stroke="#111" stroke-width="1.5" />
          <text x="${pin.x}" y="${pin.y - 14}" text-anchor="middle" fill="#EAE3D2" font-family="Cairo" font-size="10">${pin.label}</text>
        </g>
      `).join("");

      document.getElementById("modalContent").innerHTML = `
        <h2>${story.title}</h2>
        <div style="font-family:Cairo; font-size:0.84rem; color:var(--text-secondary); margin-bottom:1.5rem;">
          ⏱ وقت القراءة: ${story.readTime} • ✍ تحرير: منصة راوي التاريخ
        </div>
        ${story.content}
        <blockquote class="historical-quote">${story.quote}<cite>— ${story.quoteAuthor}</cite></blockquote>
        <div class="interactive-map-box">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
            <strong class="font-ui" style="font-size:0.95rem;">🗺 خريطة تفاعلية: اضغط على النقاط لاستكشاف المواقع</strong>
            <button class="btn-outline" style="padding:0.35rem 0.85rem; font-size:0.78rem;" onclick="openMotionModal('${story.motionKey}')">▶ عرض الموشن المرافق</button>
          </div>
          <svg viewBox="0 0 400 200" width="100%" style="background:#1A1714; border-radius:10px; border:1px solid var(--border-subtle);">
            <path d="M20 40 Q 150 20, 380 60" stroke="rgba(197,160,89,0.2)" fill="none" stroke-dasharray="4 4"/>
            <path d="M40 160 Q 200 110, 360 150" stroke="rgba(90,169,230,0.25)" stroke-width="4" fill="none"/>
            ${pinsSvg}
          </svg>
          <div id="mapInfoPanel" class="map-info-panel"><strong>${story.mapPins[0].label}:</strong> ${story.mapPins[0].detail}</div>
        </div>
      `;
      const overlay = document.getElementById("storyModalOverlay");
      overlay.classList.add("open");
      overlay.scrollTop = 0;
      updateReadingProgress();
    }

    window.selectMapPin = function(storyId, pinIdx) {
      const story = storiesData.find(s => s.id === storyId);
      const pin = story.mapPins[pinIdx];
      document.getElementById("mapInfoPanel").innerHTML = `<strong>${pin.label}:</strong> ${pin.detail}`;
    };

    function closeStoryModal() { document.getElementById("storyModalOverlay").classList.remove("open"); }
    const storyOverlay = document.getElementById("storyModalOverlay");
    function updateReadingProgress() {
      const maxScroll = storyOverlay.scrollHeight - storyOverlay.clientHeight;
      const pct = maxScroll > 0 ? (storyOverlay.scrollTop / maxScroll) * 100 : 0;
      document.getElementById("readingProgress").style.width = `${Math.min(100, pct)}%`;
    }
    storyOverlay.addEventListener("scroll", updateReadingProgress);

    function openMotionModal(key) {
      const item = motionCatalog[key] || motionCatalog.qadisiyyah;
      document.getElementById("motionModalBody").innerHTML = `
        <div class="motion-stage">
          <svg viewBox="0 0 400 225" width="100%" height="100%" style="position:absolute; inset:0;">
            <defs>
              <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="${item.color}" stop-opacity="0.22"/>
                <stop offset="100%" stop-color="#0F0D0B" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <rect width="400" height="225" fill="url(#glow)" />
            <path d="${item.path}" stroke="${item.color}" stroke-width="3.5" fill="none" class="motion-animated-path" stroke-linecap="round" />
          </svg>
          <div style="position:relative; z-index:2; max-width:460px;">
            <span style="display:inline-block; padding:0.25rem 0.75rem; border-radius:999px; background:rgba(197,160,89,0.18); color:#C5A059; font-family:Cairo; font-size:0.75rem; margin-bottom:0.75rem;">
              ▶ قيد التشغيل — راوي التاريخ موشن
            </span>
            <h3 style="font-size:1.55rem; margin-bottom:0.5rem;">${item.title}</h3>
            <p style="font-size:0.92rem; color:#BEB5A6;">${item.desc}</p>
          </div>
        </div>
      `;
      document.getElementById("motionModalOverlay").classList.add("open");
    }

    function closeMotionModal() {
      document.getElementById("motionModalOverlay").classList.remove("open");
      document.getElementById("motionModalBody").innerHTML = "";
    }

    function closeModalOnBackdrop(e, id) {
      if (e.target.id === id) {
        if (id === "storyModalOverlay") closeStoryModal();
        if (id === "motionModalOverlay") closeMotionModal();
      }
    }

    const revealObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add("visible"); revealObserver.unobserve(entry.target); }
      });
    }, { threshold: 0.14 });
    document.querySelectorAll(".reveal").forEach(el => revealObserver.observe(el));
  </script>
</body>
</html>
